# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env

# IDE
.DS_Store
.vscode/
.idea/

# Laufzeit-Daten: persoenliche Praeferenzen (Geschmack + Bewertungen)
data/praeferenzen.json
# Laufzeit-Daten: aus Bewertungen GELERNTE bzw. manuell angelegte Kochbuch-Rezepte
# (die mitgelieferten seed_*-Rezepte bleiben bewusst versioniert)
data/rezepte/gelernt_*.json
# Laufzeit-Daten: vom Nutzer gespeicherte Wochenplaene
data/wochenplaene/

# Logs
*.log
logs/

# Entwicklungstools (nicht Teil des Projekts)
.claude/
.DS_Store

# Hinweis: app/, tests/ und docs/ werden BEWUSST versioniert
# (sie sind Teil der Abgabe).

# Vorlesungsunterlagen und Aufgabenstellung (Material des Profs, nicht weiterverbreiten)
docs/Bisherige Vorlesungsinhalte/
semesterprojekt.md
semesterprojekt_anleitung*.pdf
semesterprojekt_bewertung*.pdf

# Sonstiges
# Artefakt eines fehlgeschlagenen Clones. Unter Windows entsteht der Ordner als
# "https_" (Doppelpunkt ist auf NTFS unzulaessig) -- deshalb Wildcard statt "https:/".
https*/

# Streamlit-Secrets (Standardablage fuer Keys -- gehoert nie ins Repo;
# die Projekt-Konfiguration .streamlit/config.toml bleibt dagegen versioniert)
.streamlit/secrets.toml

# Test cache
.pytest_cache/
.coverage
htmlcov/
