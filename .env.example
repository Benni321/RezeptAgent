# Groq API Key
GROQ_API_KEY=gsk-...
# Tavily API Key (fuer Web-Suche, kostenlos unter tavily.com)
TAVILY_API_KEY=tvly-...

# Optionale Einstellungen (Defaults greifen, wenn nicht gesetzt)
# Textmodell: qwen/qwen3.6-27b -- zuverlaessiges Tool-Calling, schnell und
# multimodal (deckt Text UND Vision ab). Alternative mit staerkerer Qualitaet,
# aber langsamer: openai/gpt-oss-120b.
# NICHT nutzen: llama-3.3-70b-versatile (auf Groq zeitweise defektes Tool-Call-Format,
# "tool_use_failed"). Ebenfalls nicht mehr verfuegbar: qwen/qwen3-32b und
# meta-llama/llama-4-scout-17b-16e-instruct (von Groq im Juli 2026 zurueckgezogen).
# Reasoning-Ausgaben (<think>...) filtert app/core/text_utils.py heraus.
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Modell-Split: kleines Modell fuer abgeschlossene Einzelschritte ohne Planung
# (Recherche-Sub-Agent, Naehrwert-Schaetzung). Groq-Limits gelten PRO Modell --
# der Split verteilt einen Agent-Lauf auf zwei TPM-Toepfe (weniger 429-Backoffs).
GROQ_MODEL_KLEIN=llama-3.1-8b-instant

# Kochbuch-RAG (W3/W4): Verzeichnis der Rezept-Wissensbasis (Seeds + gelernte
# Rezepte aus 4+-Sterne-Bewertungen). Default: data/rezepte
# KOCHBUCH_DIR=data/rezepte

# Websuche: maximale Tavily-Treffer pro Suche (Default: 3 — weniger Such-"Rauschen"
# im Sub-Agent-Kontext und schont das Free-Tier-Token-Limit).
# WEB_SEARCH_MAX=3

# Observability (W5/VL09): Wenn gesetzt, wird jeder Agent-Run zusaetzlich als
# EINE JSON-Datei (<trace_id>.json) in dieses Verzeichnis geschrieben —
# gemeinsame Trace-Quelle fuer Eval-Runner und Evidence. Leer/weglassen = aus.
# AGENT_TRACE_DIR=docs/evidence/eval_traces/runs
